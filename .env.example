# @BotFather bergan token
BOT_TOKEN=123456:ABC-DEF...

# Bosh adminlar Telegram ID raqamlari (vergul bilan). ID ni botga /me yozib bilib olasiz.
ADMIN_IDS=111111111,222222222

# Hozircha kompyuterdagi SQLite fayl. Supabase'ga o'tganda Postgres manzilini qo'ying:
# DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Standart til: uz, ru yoki en
DEFAULT_LANG=uz

# Chaqiruvni hech kim qabul qilmasa, necha daqiqadan keyin adminlarga yuborilsin
ESCALATE_MINUTES=5
# Shoshilinch (#doctor!) chaqiruvlar uchun
URGENT_ESCALATE_MINUTES=2

# Vaqt mintaqasi (Toshkent = UTC+5)
TZ_OFFSET_HOURS=5

# Faqat Vercel uchun: Telegram va Supabase Cron botga murojaat qilganini tekshiradigan maxfiy so'z.
# Yaratish: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
